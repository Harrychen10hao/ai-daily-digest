# OpenAI 兼容模型服务
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 飞书群机器人 Webhook
FEISHU_WEBHOOK_URL=

# 可选运行参数
DATA_DIR=data
SOURCES_FILE=config/sources.yaml
